    const ok=METHODS.map(()=>0);let done=0;
    for(let t=0;t<T;t++){
      const smp=sampleText(body,L);if(!smp)continue;done++;
      const key=1+Math.floor(Math.random()*25), ct=shiftText(smp,key);
      METHODS.forEach((m,i)=>{if(pick(scoreMethod(m,ct))===key)ok[i]++;});
    }
    const pc=ok.map(v=>done?v/done*100:0);rates.push(pc);
    rows.push(`<tr><td>${L}</td>${pc.map(q=>`<td><span class="pb"><i style="width:${q}%"></i></span>${q.toFixed(0)}%</td>`).join('')}</tr>`);
  }
  $('ttab').querySelector('tbody').innerHTML=rows.join('');
  const first=m=>{const i=rates.findIndex(r=>r[m]>=95);return i<0?'not reached':LENS[i]+' letters';};
  const names=['χ² with the own corpus','χ² with the textbook table','the "E" shortcut','bigram scoring','the dictionary search'];
  $('tnotes').innerHTML=`<p>Success rates over ${T} random trials per length (the sampling error is at most ±${(196*Math.sqrt(0.25/T)).toFixed(0)} percentage points). First length with at least 95% success: ${names.map((n,i)=>n+' '+first(i)).join('; ')}. A random guess among 25 keys would be right 4% of the time.</p>`;
  $('teststate').textContent='';
}

/* ---------- ECC attacks ---------- */
const ATK={stop:false,run:false};
function madd(X1,Y1,Z1){ // (X1:Y1:Z1) + G, G affine (Jacobian mixed addition)
  const ZZ=mm(Z1*Z1),U2=mm(G[0]*ZZ),S2=mm(G[1]*mm(Z1*ZZ)),H=mm(U2-X1),HH=mm(H*H),I=4n*HH,J=mm(H*I),r=2n*(S2-Y1),V=mm(X1*I);
  const X3=mm(r*r-J-2n*V);return [X3,mm(r*(V-X3)-2n*Y1*J),mm((Z1+H)*(Z1+H)-ZZ-HH)];
}
async function brute(target,nbits,onp){
  const lim=Math.pow(2,nbits), tx=target[0], ty=target[1], t0=performance.now();
  if(G[0]===tx&&G[1]===ty)return {d:1n,steps:1,ms:0};
  const p2=Core.ecAdd(G,G);let X=p2[0],Y=p2[1],Z=1n,j=2;
  while(j<lim){
    const end=Math.min(lim,j+3000);
    for(;j<end;j++){
      const zz=mm(Z*Z);
      if(X===mm(tx*zz)&&Y===mm(ty*mm(zz*Z)))return {d:BigInt(j),steps:j-1,ms:performance.now()-t0};
      [X,Y,Z]=madd(X,Y,Z);
    }
    onp(j/lim,j);await tick();if(ATK.stop)return null;
  }
  return null;
}
async function bsgs(target,nbits,onp){
  const t0=performance.now(), m=Math.ceil(Math.sqrt(Math.pow(2,nbits)));let steps=0;
  const tab=new Map();let pt=null;
  for(let j=1;j<=m;j++){
    pt=Core.ecAdd(pt,G);tab.set(pt[0],[j,pt[1]]);steps++;
    if(j%400===0){onp(0.5*j/m,steps);await tick();if(ATK.stop)return null;}
  }
  const negM=[pt[0],P-pt[1]];let cur=target;
  for(let i=0;i<=m;i++){
    if(cur===null){const d=BigInt(i)*BigInt(m);if(d>0n&&Core.ecMul(d)[0]===target[0])return {d,steps,ms:performance.now()-t0,m};}
    else{
      const e=tab.get(cur[0]);
      if(e){
        const cands=[BigInt(i)*BigInt(m)+BigInt(e[0]),BigInt(i)*BigInt(m)-BigInt(e[0])];
        for(const d of cands){if(d>0n){const q=Core.ecMul(d);if(q[0]===target[0]&&q[1]===target[1])return {d,steps,ms:performance.now()-t0,m};}}
      }
    }
    cur=Core.ecAdd(cur,negM);steps++;
    if(i%400===0){onp(0.5+0.5*i/m,steps);await tick();if(ATK.stop)return null;}
  }
  return null;
}
function showTarget(){
  if(!E.d){$('tgt').textContent='Generate keys first.';return;}
  const ct=E.ct;
  $('tgt').innerHTML='n = '+E.bits+' bits, so d is somewhere in 1 … '+(Math.pow(2,E.bits)-1).toLocaleString('en')+'<br>Q.x = 0x'+h(E.Q[0])+(ct?'<br>C₁.x = 0x'+h(ct.C1[0])+'<br>C₂ = 0x'+hex(ct.C2):'<br>No ciphertext yet. One is made when an attack starts.');
}
async function launch(kind){
  if(ATK.run)return;
  if(!E.d)genKeys();if(!E.ct)encrypt();
  ATK.run=true;ATK.stop=false;
  ['bbrute','bbsgs','benc','bgen'].forEach(i=>$(i).disabled=true);
  const n=E.bits, label=kind==='brute'?'Exhaustive search':'Baby-step giant-step';
  $('atkres').textContent='Searching …';$('atkdet').textContent='';
  const t0=performance.now();
  const onp=(f,s)=>{$('prog').value=f*100;$('atkstate').textContent=label+': '+s.toLocaleString('en')+' steps, '+((performance.now()-t0)/1000).toFixed(1)+' s'+(kind==='brute'?' (the average is '+Math.pow(2,n-1).toLocaleString('en')+' steps)':'');};
  const r=await (kind==='brute'?brute:bsgs)(E.Q,n,onp);
  if(r){
    const chk=Core.ecMul(r.d), good=chk[0]===E.Q[0]&&chk[1]===E.Q[1];
    const t=eccDecrypt(r.d,E.ct.C1,E.ct.C2);
    $('prog').value=100;
    $('atkres').innerHTML='d = '+r.d.toString();
    $('atkdet').innerHTML=`Check d·G = Q: ${good?'<span class="ok">yes</span>':'<span class="bad">no</span>'}. Real key: ${E.d.toString()} (${r.d===E.d?'<span class="ok">match</span>':'<span class="bad">different</span>'}).<br>${r.steps.toLocaleString('en')} steps in ${(r.ms/1000).toFixed(2)} s${r.m?' (table of '+r.m.toLocaleString('en')+' points)':''}.<br>Decrypted message: <b>${esc(dec.decode(t.m))}</b>`;
    $('atkstate').textContent=label+' finished.';
  }else{
    $('atkres').textContent=ATK.stop?'Stopped.':'Not found.';
    $('atkstate').textContent=label+(ATK.stop?' stopped.':' finished without a result.');
  }
  ATK.run=false;['bbrute','bbsgs','benc','bgen'].forEach(i=>$(i).disabled=false);
}

/* ---------- speed benchmark and extrapolation ---------- */
function fmtTime(s){
  if(s<1e-3)return '< 1 ms';if(s<1)return (s*1000).toFixed(0)+' ms';if(s<60)return s.toFixed(1)+' s';
  if(s<3600)return (s/60).toFixed(1)+' min';if(s<86400)return (s/3600).toFixed(1)+' hours';
  const y=s/31557600;if(y<1)return (s/86400).toFixed(1)+' days';if(y<1e6)return Math.round(y).toLocaleString('en')+' years';return sci(y)+' years';
}
function fmtBytes(b){
  const u=['bytes','KB','MB','GB','TB','PB'];let i=0;while(b>=1000&&i<5){b/=1000;i++;}
  return b>=1000?sci(b)+' PB':(b<10?b.toFixed(1):Math.round(b))+' '+u[i];
}
function benchmark(){
  let t=performance.now(),X,Y,Z=1n;const p2=Core.ecAdd(G,G);X=p2[0];Y=p2[1];let n=0;
  while(performance.now()-t<120){for(let i=0;i<500;i++)[X,Y,Z]=madd(X,Y,Z);n+=500;}
  const rj=n/((performance.now()-t)/1000);
  t=performance.now();let a=G;n=0;
  while(performance.now()-t<120){for(let i=0;i<20;i++)a=Core.ecAdd(a,G);n+=20;}
  const ra=n/((performance.now()-t)/1000);
  $('rates').textContent='Measured here: about '+Math.round(rj).toLocaleString('en')+' steps per second for the exhaustive search and '+Math.round(ra).toLocaleString('en')+' for baby-step giant-step.';
  const rows=[16,32,48,64,128,256].map(n=>{
    const bf=Math.pow(2,n-1)/rj, bs=2*Math.pow(2,n/2)/ra, mem=Math.pow(2,n/2)*40;
    const bar=s=>`<span class="pb"><i style="width:${Math.max(1,Math.min(100,(Math.log10(Math.max(s,1e-3))+3)/75*100))}%"></i></span>`;
    return `<tr><td>${n}${n===256?' (secp256k1)':''}</td><td>${bar(bf)}${fmtTime(bf)}</td><td>${bar(bs)}${fmtTime(bs)}</td><td>${fmtBytes(mem)}</td></tr>`;
  });
  $('extra').querySelector('tbody').innerHTML=rows.join('');
}

/* ---------- demos of design weaknesses ---------- */
function needKeys(){if(!E.d)genKeys();if(!E.ct)encrypt();}
function demoReuse(){
  needKeys();
  const mA=enc.encode($('msg').value||' '), mB=enc.encode('Send the money to Alice now, quickly please').slice(0,mA.length);
  const S=Core.ecMul(E.ct.r,E.Q), ks=keystream(S[0],mA.length);   // the same r, so the same keystream
  const cA=xor(mA,ks), cB=xor(mB,ks), x=xor(cA,cB);
  const rec=xor(x,mA).slice(0,mB.length);
  $('demo').textContent='Two messages encrypted with the same r (same C₁, same keystream).\n\nC₂ of message 1: '+hex(cA)+'\nC₂ of message 2: '+hex(cB)+'\nXOR of the two:  '+hex(x)+'\n\nThe XOR equals the XOR of the two plain texts. An attacker who knows or guesses message 1 ("'+dec.decode(mA)+'") gets message 2 without any key:\n"'+dec.decode(rec)+'"';
}
function demoMalleable(){
  needKeys();
  const m=enc.encode($('msg').value||' '), c2=E.ct.C2.slice();
  const want='Z'.charCodeAt(0);c2[0]^=m[0]^want;   // attacker knows the first letter and turns it into Z
  const t=eccDecrypt(E.d,E.ct.C1,c2);
  $('demo').textContent='The attacker knows the first letter ("'+String.fromCharCode(m[0])+'") and XORs the first byte of C₂ with the difference to "Z". The receiver decrypts normally and gets:\n"'+dec.decode(t.m)+'"\n\nNo key was needed and nothing warns the receiver. A real scheme adds a message authentication code.';
}
async function demoSmallR(){
  if(ATK.run)return;
  if(!E.d)genKeys();
  const was=$('rsmall').checked;$('rsmall').checked=true;encrypt();
  $('demo').textContent='Encrypting with r drawn from '+E.bits+' bits. The attacker does not search for d. The attacker searches for r with C₁ = r·G, using baby-step giant-step on the public value C₁ …';
  ATK.run=true;ATK.stop=false;
  const r=await bsgs(E.ct.C1,E.bits,()=>{});
  ATK.run=false;
  if(r){
    const S=Core.ecMul(r.d,E.Q), m=xor(E.ct.C2,keystream(S[0],E.ct.C2.length));
    $('demo').textContent='Found r = '+r.d+' ('+r.steps.toLocaleString('en')+' steps, '+(r.ms/1000).toFixed(2)+' s). Then S = r·Q, the keystream follows, and the message comes out without d:\n"'+dec.decode(m)+'"\n\nThe private key d is still unknown. The one-time key was the weak point. With a 128-bit r this search would be as hopeless as in section 7.';
  }else $('demo').textContent='Search failed.';
  $('rsmall').checked=was;
}

